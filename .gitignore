# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored agent skills (regenerable from skills-lock.json)
.agents/
.claude/skills/grill-me
.claude/skills/supabase
.claude/skills/supabase-postgres-best-practices

# agent worktrees
.claude/worktrees/

# playwright-mcp debug artifacts
.playwright-mcp/

# supabase CLI scratch
supabase/.temp/

# local debug screenshots
/screenshot-*.png
/login-*.png
